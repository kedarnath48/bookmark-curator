import React from 'react';
import bookmarksFile from '../utils/bookmarks.json';

//import unsortedData from './utils/cat.unsorted.json'
//import duplicatesData from './utils/cat.duplicates.json'
//import trashData from './utils/cat.trash.json'

interface Bookmark {
  guid: string;
  id: number;
  index: number;
  title: string;
  url: string;
  favourite: boolean;
  tags: string[];
  filters: string[];
  duplicate: boolean;
  broken: boolean;
  coverImage: string;
  note: string;
  description: string;
  dateAdded: string;
}
interface BookmarksContainerProps {
  ctr: string;
  guids: string[];
}

const BookmarksContainer: React.FC<BookmarksContainerProps> = ({ctr, guids }) => {
  const bookmarksData: Bookmark[] = bookmarksFile as Bookmark[];
  let bookmarks: Bookmark[] = [];

  if (ctr === 'all bookmarks') {
    bookmarks = bookmarksData;
  } else {
    bookmarks = bookmarksData.filter(bookmark => guids.includes(bookmark.guid));
  }

  console.log(ctr, bookmarks)
  return (
    <div className='bookmarks-ctr'>
      <h2>{ctr}</h2>
      {bookmarks.length === 0 ? (
        <p>No GUIDs provided.</p>
      ) : (
        <ol className='view-ol'>
          {bookmarks.map(bookmark => (
            <li key={bookmark.guid}>
              <div className="img-wrapper"></div>
              <div className="bookmarks-info">
                <div className="site-title">
                  <a href={bookmark.url} target="_blank" rel="noopener noreferrer">
                    <span>{bookmark.title}</span>
                  </a>
                </div>
                <div className="tags-wrapper">
                  {bookmark.tags.map((tag, index) => (
                    <span key={index} className="txt tag">{tag}</span>
                  ))}
                </div>
                <div className="site-name">{bookmark.url}</div>
                <div className="more-info">
                  {bookmark.favourite && <div className="favourite-div"><i className="fa-solid fa-heart"></i></div>}
                  {bookmark.duplicate && <div className="duplicate-div"><i className="fa-solid fa-clone"></i></div>}
                  {bookmark.broken && <div className="broken-div"><i className="fa-solid fa-link-slash"></i></div>}
                  <div className="date-added">{bookmark.dateAdded}</div>
                </div>
              </div>
            </li>
          ))}
        </ol>
      )}
    </div>
  );
};

export default BookmarksContainer;